{
  "system": "CRM — system sprzedaży i backoffice",
  "purpose": "CRM dla handlowców i backoffice: klienci, leady, pipeline, aktywności, zamówienia, obsługa realizacji, raporty oraz integracje.",
  "bounded_contexts": [
    {
      "name": "Customer Management",
      "responsibility": "Źródło prawdy dla danych klienta: karta klienta, dane kontaktowe, adresy i status.",
      "actors": [
        "handlowiec",
        "menedżer sprzedaży",
        "backoffice",
        "admin"
      ],
      "aggregates": [
        {
          "name": "Customer",
          "entities": [
            "ContactPerson",
            "CustomerAddress"
          ],
          "value_objects": [
            "CustomerStatus",
            "TaxId",
            "EmailAddress",
            "PhoneNumber",
            "Address"
          ],
          "commands": [
            "CreateCustomer",
            "UpdateCustomerData",
            "AddContactPerson",
            "ChangeCustomerStatus"
          ],
          "events": [
            "CustomerCreated",
            "CustomerUpdated",
            "ContactPersonAdded",
            "CustomerStatusChanged"
          ]
        }
      ]
    },
    {
      "name": "Lead & Pipeline",
      "responsibility": "Obsługa leadów, kwalifikacji, opportunity i etapów pipeline sprzedażowego.",
      "actors": [
        "handlowiec",
        "menedżer sprzedaży"
      ],
      "aggregates": [
        {
          "name": "Lead",
          "entities": [],
          "value_objects": [
            "LeadSource",
            "LeadPriority",
            "LeadStatus",
            "QualificationData"
          ],
          "commands": [
            "RegisterLead",
            "AssignLeadToSalesperson",
            "QualifyLead",
            "RejectLead"
          ],
          "events": [
            "LeadRegistered",
            "LeadAssigned",
            "LeadQualified",
            "LeadRejected"
          ]
        },
        {
          "name": "Opportunity",
          "entities": [
            "StageHistoryEntry"
          ],
          "value_objects": [
            "OpportunityStage",
            "EstimatedValue (Money)",
            "Probability",
            "ExpectedCloseDate",
            "LostReason"
          ],
          "commands": [
            "CreateOpportunity",
            "MoveOpportunityToStage",
            "MarkOpportunityAsWon",
            "MarkOpportunityAsLost"
          ],
          "events": [
            "OpportunityCreated",
            "OpportunityStageChanged",
            "OpportunityWon",
            "OpportunityLost"
          ]
        },
        {
          "name": "Pipeline",
          "entities": [
            "PipelineStage"
          ],
          "value_objects": [
            "StageDefinition",
            "TransitionRules"
          ],
          "commands": [
            "ConfigurePipeline",
            "AddPipelineStage",
            "ChangeTransitionRules"
          ],
          "events": [
            "PipelineConfigured",
            "PipelineStageChanged"
          ]
        }
      ]
    },
    {
      "name": "Sales Activity",
      "responsibility": "Planowanie kontaktów, follow-upów, notatek i rejestracja aktywności handlowca.",
      "actors": [
        "handlowiec",
        "menedżer sprzedaży"
      ],
      "aggregates": [
        {
          "name": "SalesActivity",
          "entities": [],
          "value_objects": [
            "ActivityType",
            "ActivityOutcome",
            "ActivityTimeRange"
          ],
          "commands": [
            "RegisterPhoneCall",
            "RegisterMeeting",
            "RegisterEmailActivity",
            "CompleteActivity"
          ],
          "events": [
            "ActivityRegistered",
            "ActivityCompleted"
          ]
        },
        {
          "name": "FollowUpTask",
          "entities": [
            "Reminder"
          ],
          "value_objects": [
            "DueDate",
            "TaskStatus",
            "TaskPriority"
          ],
          "commands": [
            "ScheduleFollowUp",
            "PostponeFollowUp",
            "CompleteFollowUp"
          ],
          "events": [
            "FollowUpScheduled",
            "FollowUpCompleted"
          ]
        },
        {
          "name": "Note",
          "entities": [],
          "value_objects": [
            "NoteContent"
          ],
          "commands": [
            "AddCustomerNote",
            "UpdateNote"
          ],
          "events": [
            "NoteAdded",
            "NoteUpdated"
          ]
        }
      ]
    },
    {
      "name": "Sales Order Capture",
      "responsibility": "Utworzenie i przekazanie zamówienia przez handlowca po finalizacji sprzedaży.",
      "actors": [
        "handlowiec",
        "menedżer sprzedaży"
      ],
      "aggregates": [
        {
          "name": "SalesOrder",
          "entities": [
            "SalesOrderLine"
          ],
          "value_objects": [
            "OrderTerms",
            "OrderCustomerSnapshot",
            "OrderStatus",
            "Money"
          ],
          "commands": [
            "CreateSalesOrder",
            "AddOrderLine",
            "UpdateOrderTerms",
            "SubmitSalesOrder",
            "CancelSalesOrder"
          ],
          "events": [
            "SalesOrderCreated",
            "SalesOrderSubmitted",
            "SalesOrderCancelled"
          ]
        }
      ]
    },
    {
      "name": "Backoffice Order Processing",
      "responsibility": "Obsługa i realizacja zamówienia po stronie backoffice, niezależnie od pipeline sprzedażowego.",
      "actors": [
        "backoffice",
        "realizacja/operations",
        "handlowiec",
        "menedżer backoffice"
      ],
      "aggregates": [
        {
          "name": "OrderProcess",
          "entities": [
            "OrderClarification",
            "StatusHistoryEntry",
            "FulfillmentRequest"
          ],
          "value_objects": [
            "ProcessStatus",
            "FulfillmentData"
          ],
          "commands": [
            "StartOrderProcessing",
            "AssignOrderProcess",
            "RequestMissingInformation",
            "AcceptOrderForFulfillment",
            "CompleteOrderProcess",
            "RejectOrderProcess"
          ],
          "events": [
            "OrderProcessingStarted",
            "OrderAssigned",
            "MissingInformationRequested",
            "MissingInformationProvided",
            "OrderAcceptedForFulfillment",
            "OrderCompleted",
            "OrderRejected"
          ]
        },
        {
          "name": "BackofficeTask",
          "entities": [],
          "value_objects": [
            "TaskType",
            "TaskStatus",
            "DueDate"
          ],
          "commands": [
            "CreateBackofficeTask",
            "AssignBackofficeTask",
            "CompleteBackofficeTask"
          ],
          "events": [
            "BackofficeTaskCreated",
            "BackofficeTaskCompleted"
          ]
        }
      ]
    },
    {
      "name": "Integration Context",
      "responsibility": "ACL dla ERP, fakturowania, e-maila, kalendarza i płatności.",
      "actors": [
        "system CRM",
        "ERP",
        "system fakturowy",
        "e-mail",
        "kalendarz",
        "system płatności"
      ],
      "aggregates": [
        {
          "name": "IntegrationJob",
          "entities": [
            "JobAttempt"
          ],
          "value_objects": [
            "ExternalSystemName",
            "JobStatus",
            "CorrelationId"
          ],
          "commands": [
            "CreateIntegrationJob",
            "RetryIntegrationJob",
            "MarkIntegrationJobAsSucceeded",
            "MarkIntegrationJobAsFailed"
          ],
          "events": [
            "IntegrationJobCreated",
            "IntegrationJobSucceeded",
            "IntegrationJobFailed"
          ]
        },
        {
          "name": "ExternalSystemMapping",
          "entities": [],
          "value_objects": [
            "ExternalId",
            "InternalId"
          ],
          "commands": [
            "CreateExternalMapping",
            "UpdateExternalMapping"
          ],
          "events": [
            "ExternalMappingCreated"
          ]
        },
        {
          "name": "InvoiceRequest",
          "entities": [],
          "value_objects": [
            "InvoiceData",
            "BillingAddress"
          ],
          "commands": [
            "CreateInvoiceRequest",
            "SubmitInvoiceRequest",
            "MarkInvoiceIssued"
          ],
          "events": [
            "InvoiceRequested",
            "InvoiceIssued",
            "PaymentReceived"
          ]
        }
      ]
    },
    {
      "name": "Reporting & Analytics",
      "responsibility": "Read models/projekcje dla pipeline, KPI, zamówień i przychodów.",
      "actors": [
        "menedżer sprzedaży",
        "zarząd",
        "admin",
        "backoffice manager"
      ],
      "read_models": [
        "SalesPipelineReport",
        "SalespersonKpiReport",
        "OrderProcessingReport",
        "RevenueReport",
        "CustomerBaseReport",
        "ActivityReport",
        "OrderIntakeReport"
      ]
    },
    {
      "name": "Identity & Access",
      "responsibility": "Użytkownicy, role, uprawnienia, zespoły i kontrola dostępu.",
      "actors": [
        "admin",
        "system",
        "menedżer"
      ],
      "aggregates": [
        {
          "name": "User",
          "entities": [],
          "value_objects": [
            "UserId",
            "UserStatus",
            "EmailAddress"
          ],
          "commands": [
            "CreateUser",
            "DeactivateUser"
          ],
          "events": [
            "UserCreated",
            "UserDeactivated"
          ]
        },
        {
          "name": "Role",
          "entities": [
            "Permission"
          ],
          "value_objects": [
            "RoleName"
          ],
          "commands": [
            "AssignRole"
          ],
          "events": [
            "RoleAssigned"
          ]
        },
        {
          "name": "SalesTeam",
          "entities": [
            "TeamMember"
          ],
          "value_objects": [
            "TeamName"
          ],
          "commands": [
            "AssignUserToSalesTeam"
          ],
          "events": [
            "UserAssignedToSalesTeam"
          ]
        }
      ]
    }
  ],
  "architectural_rules": [
    "Customer Management owns Customer. Other contexts use CustomerId and snapshots/read models.",
    "Lead & Pipeline owns Lead, Opportunity and Pipeline. Backoffice must not modify the sales pipeline.",
    "Sales Order Capture owns SalesOrder and submits it to Backoffice through SalesOrderSubmitted.",
    "Backoffice Order Processing owns OrderProcess and operational realization status. Sales must not change backoffice processing status directly.",
    "Cross-context state changes should happen through integration events. Synchronous calls are allowed mainly for queries/snapshots and authorization checks.",
    "Reporting & Analytics is projection/read-model oriented and should be updated from events."
  ]
}