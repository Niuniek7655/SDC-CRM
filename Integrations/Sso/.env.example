# Local development overrides for Integrations/Sso/docker-compose.yml.
#
# Copy this file to .env (git-ignored) in this directory and change the values if needed.
# Every variable is optional: without a .env file docker-compose.yml falls back to the
# development defaults shown below. Never reuse these values in production.
#
# Note: PostgreSQL applies POSTGRES_USER/POSTGRES_PASSWORD/POSTGRES_DB only when the data
# volume is created for the first time. After changing them run: docker compose down -v

# PostgreSQL for the identity server
POSTGRES_USER=idserver
POSTGRES_PASSWORD=SsoSecurePassword123!
POSTGRES_DB=IdServer
POSTGRES_PORT=5433

# Identity server (OIDC authority http://localhost:<IDSERVER_PORT>/master).
# Changing the port also requires updating Oidc:Authority (API), sso.issuer (web) and AppConfig.Authority (mobile).
IDSERVER_PORT=5001

# Administration panel
WEBSITE_PORT=5002

# SimpleIdServer image version (https://hub.docker.com/u/simpleidserver)
SID_VERSION=6.0.4

# Secret of the SIDS-manager client seeded by SimpleIdServer (used by the admin panel
# and by register-sdc-crm-clients.ps1 -AdminClientSecret)
SIDS_MANAGER_CLIENT_SECRET=password

