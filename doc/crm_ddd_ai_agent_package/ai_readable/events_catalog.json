  "integration_communication": [
    {
      "event": "CustomerCreated / CustomerUpdated",
      "publisher": "Customer.Customer Management",
      "subscribers": [
        "Lead & Pipeline",
        "Sales Activity",
        "Reporting & Analytics"
      ],
      "when": "po utworzeniu lub zmianie danych klienta"
    },
    {
      "event": "OpportunityWon",
      "publisher": "Opportunity.Lead & Pipeline",
      "subscribers": [
        "Sales Order Capture",
        "Reporting & Analytics"
      ],
      "when": "gdy sprzedaż została wygrana"
    },
    {
      "event": "OpportunityLost",
      "publisher": "Opportunity.Lead & Pipeline",
      "subscribers": [
        "Reporting & Analytics"
      ],
      "when": "gdy szansa została przegrana"
    },
    {
      "event": "SalesOrderCreated",
      "publisher": "SalesOrder.Sales Order Capture",
      "subscribers": [
        "Reporting & Analytics"
      ],
      "when": "po utworzeniu szkicu zamówienia"
    },
    {
      "event": "SalesOrderSubmitted",
      "publisher": "SalesOrder.Sales Order Capture",
      "subscribers": [
        "Backoffice Order Processing",
        "Reporting & Analytics"
      ],
      "when": "gdy handlowiec przekazuje kompletne zamówienie"
    },
    {
      "event": "MissingInformationRequested",
      "publisher": "OrderProcess.Backoffice Order Processing",
      "subscribers": [
        "Sales Activity"
      ],
      "when": "gdy backoffice wykryje braki w danych"
    },
    {
      "event": "MissingInformationProvided",
      "publisher": "Sales Activity / Backoffice",
      "subscribers": [
        "Backoffice Order Processing"
      ],
      "when": "gdy handlowiec uzupełni brakujące dane"
    },
    {
      "event": "OrderAcceptedForFulfillment",
      "publisher": "OrderProcess.Backoffice Order Processing",
      "subscribers": [
        "Integration Context",
        "Reporting & Analytics"
      ],
      "when": "gdy zamówienie zostaje zaakceptowane do realizacji"
    },
    {
      "event": "InvoiceRequested",
      "publisher": "Backoffice / Integration",
      "subscribers": [
        "Integration Context"
      ],
      "when": "gdy trzeba wystawić fakturę lub przekazać dane do ERP"
    },
    {
      "event": "InvoiceIssued",
      "publisher": "Integration Context",
      "subscribers": [
        "Reporting & Analytics",
        "Backoffice Order Processing"
      ],
      "when": "gdy faktura została wystawiona"
    },
    {
      "event": "PaymentReceived",
      "publisher": "Integration Context",
      "subscribers": [
        "Reporting & Analytics",
        "Backoffice Order Processing"
      ],
      "when": "gdy pojawi się informacja o płatności"
    },
    {
      "event": "OrderCompleted",
      "publisher": "OrderProcess.Backoffice Order Processing",
      "subscribers": [
        "Reporting & Analytics",
        "Sales Activity",
        "Integration Context"
      ],
      "when": "gdy proces obsługi zamówienia zostaje zakończony"
    }
  ]
}