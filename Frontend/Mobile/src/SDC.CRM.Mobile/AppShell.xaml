<?xml version="1.0" encoding="UTF-8" ?>
<Shell
    x:Class="SDC.CRM.Mobile.AppShell"
    xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
    xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
    xmlns:local="clr-namespace:SDC.CRM.Mobile"
    xmlns:views="clr-namespace:SDC.CRM.Mobile.Presentation.Views"
    xmlns:navigation="clr-namespace:SDC.CRM.Mobile.Presentation.Navigation;assembly=SDC.CRM.Mobile.Core"
    FlyoutBehavior="Disabled"
    Title="SDC.CRM.Mobile">

    <!-- Route names come from AppRoutes (Core) so view models and the shell cannot drift apart. -->
    <ShellContent
        Title="Logowanie"
        Route="{x:Static navigation:AppRoutes.Login}"
        Shell.TabBarIsVisible="False"
        ContentTemplate="{DataTemplate views:LoginPage}" />

    <ShellContent
        Title="Home"
        Route="{x:Static navigation:AppRoutes.Main}"
        Shell.TabBarIsVisible="False"
        ContentTemplate="{DataTemplate local:MainPage}" />

</Shell>
