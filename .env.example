# Local development overrides for docker-compose.yml (repository root).
#
# Copy this file to .env (git-ignored) and change the values if needed.
# Every variable is optional: without a .env file docker-compose.yml falls back
# to the development defaults shown below. Never reuse these values in production.

# PostgreSQL - primary CRM database
# Keep in sync with ConnectionStrings:Crm in Backend/src/SDC.CRM.Api/appsettings.Development.json.
POSTGRES_USER=app
POSTGRES_PASSWORD=app
POSTGRES_DB=appdb

# RabbitMQ (reserved for future messaging)
RABBITMQ_DEFAULT_USER=app
RABBITMQ_DEFAULT_PASS=app

# Grafana admin account
GRAFANA_ADMIN_USER=admin
GRAFANA_ADMIN_PASSWORD=admin

