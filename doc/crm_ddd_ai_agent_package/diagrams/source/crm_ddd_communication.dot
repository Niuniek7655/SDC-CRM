digraph CRM_DDD {
  graph [
    rankdir=LR,
    compound=true,
    splines=ortho,
    nodesep=0.55,
    ranksep=1.1,
    bgcolor="white",
    fontname="Arial",
    fontsize=20,
    labelloc="t",
    label="CRM — bounded contexty, agregaty i komunikacja między nimi"
  ];

  node [shape=box, style="rounded,filled", fillcolor="white", color="#374151", fontname="Arial", fontsize=11, margin="0.12,0.08"];
  edge [fontname="Arial", fontsize=9, color="#111827", arrowsize=0.8];

  // Actors
  Salesperson [shape=ellipse, fillcolor="#fef3c7", color="#92400e", label="Aktor:\nHandlowiec"];
  SalesManager [shape=ellipse, fillcolor="#fef3c7", color="#92400e", label="Aktor:\nMenedżer\nsprzedaży"];
  BackofficeUser [shape=ellipse, fillcolor="#fef3c7", color="#92400e", label="Aktor:\nBackoffice"];
  Admin [shape=ellipse, fillcolor="#fef3c7", color="#92400e", label="Aktor:\nAdmin"];
  ERP [shape=component, fillcolor="#e0f2fe", color="#0369a1", label="System zewn.:\nERP / faktury\nmail / kalendarz\npłatności"];

  subgraph cluster_identity {
    label="Bounded Context: Identity & Access";
    style="rounded,filled";
    color="#c7d2fe";
    fillcolor="#eef2ff";
    fontname="Arial";
    fontsize=13;
    User [label="Agregat:\nUser"];
    Role [label="Agregat:\nRole / Permission"];
  }

  subgraph cluster_customers {
    label="Bounded Context: Customer Management";
    style="rounded,filled";
    color="#bbf7d0";
    fillcolor="#f0fdf4";
    fontname="Arial";
    fontsize=13;
    Customer [label="Agregat:\nCustomer\n- dane klienta\n- osoby kontaktowe\n- adresy"];
  }

  subgraph cluster_sales {
    label="Bounded Context: Sales / Lead & Pipeline";
    style="rounded,filled";
    color="#fed7aa";
    fillcolor="#fff7ed";
    fontname="Arial";
    fontsize=13;
    Lead [label="Agregat:\nLead\n- źródło\n- priorytet\n- kwalifikacja"];
    Opportunity [label="Agregat:\nOpportunity / Deal\n- etap pipeline\n- wartość\n- status Won/Lost"];
    SalesActivity [label="Agregat:\nSalesActivity\n- telefon\n- mail\n- spotkanie\n- notatka"];
    FollowUpTask [label="Agregat:\nFollowUpTask\n- kolejny kontakt\n- przypomnienie"];
  }

  subgraph cluster_orders {
    label="Bounded Context: Sales Order Capture";
    style="rounded,filled";
    color="#fbcfe8";
    fillcolor="#fdf2f8";
    fontname="Arial";
    fontsize=13;
    SalesOrder [label="Agregat:\nSalesOrder\n- pozycje\n- warunki\n- snapshot klienta\n- status Submitted"];
  }

  subgraph cluster_backoffice {
    label="Bounded Context: Backoffice Order Processing";
    style="rounded,filled";
    color="#bae6fd";
    fillcolor="#f0f9ff";
    fontname="Arial";
    fontsize=13;
    OrderProcess [label="Agregat:\nOrderProcess\n- status realizacji\n- historia\n- przydział"];
    BackofficeTask [label="Agregat:\nBackofficeTask\n- zadanie obsługi"];
    Clarification [label="Agregat:\nOrderClarification\n- braki\n- pytania\n- odpowiedzi"];
    FulfillmentRequest [label="Agregat:\nFulfillmentRequest\n- przekazanie do realizacji"];
  }

  subgraph cluster_integrations {
    label="Bounded Context: Integration / ACL";
    style="rounded,filled";
    color="#ddd6fe";
    fillcolor="#f5f3ff";
    fontname="Arial";
    fontsize=13;
    IntegrationJob [label="Agregat / proces:\nIntegrationJob\n- eksport ERP\n- faktura\n- sync e-mail/kalendarz"];
    ExternalMapping [label="Model:\nExternalSystemMapping"];
  }

  subgraph cluster_reporting {
    label="Bounded Context: Reporting & Analytics";
    style="rounded,filled";
    color="#d1d5db";
    fillcolor="#f9fafb";
    fontname="Arial";
    fontsize=13;
    SalesKPI [label="Read model:\nSalesperson KPI"];
    PipelineReport [label="Read model:\nPipeline Report"];
    OrderReport [label="Read model:\nOrder Processing Report"];
  }

  subgraph cluster_legend {
    label="Legenda";
    style="rounded,filled";
    color="#e5e7eb";
    fillcolor="#ffffff";
    fontname="Arial";
    fontsize=12;
    L1 [label="Linia ciągła:\nCommand / Query\nkomunikacja synchroniczna", shape=box, fillcolor="#ffffff"];
    L2 [label="Linia przerywana pomarańczowa:\nIntegration Event\nkomunikacja asynchroniczna", shape=box, fillcolor="#ffffff"];
    L3 [label="Linia kropkowana szara:\nEvent → projection\naktualizacja raportów", shape=box, fillcolor="#ffffff"];
  }

  // Actor commands
  Salesperson -> Customer [label="Command:\nCreate/UpdateCustomer", style=solid, color="#111827"];
  Salesperson -> Lead [label="Command:\nRegisterLead / AssignLead", style=solid, color="#111827"];
  Salesperson -> SalesActivity [label="Command:\nAddNote / RegisterContact", style=solid, color="#111827"];
  Salesperson -> FollowUpTask [label="Command:\nScheduleFollowUp", style=solid, color="#111827"];
  Salesperson -> SalesOrder [label="Command:\nCreate/SubmitOrder", style=solid, color="#111827"];
  BackofficeUser -> OrderProcess [label="Command:\nAssign / ChangeStatus", style=solid, color="#111827"];
  BackofficeUser -> Clarification [label="Command:\nRequestMissingInfo", style=solid, color="#111827"];
  Admin -> User [label="Command:\nCreateUser", style=solid, color="#111827"];
  Admin -> Role [label="Command:\nAssignRole", style=solid, color="#111827"];
  SalesManager -> PipelineReport [label="Query:\nDashboard / KPI", style=solid, color="#111827"];

  // Domain / aggregate-in-context actions
  Lead -> Opportunity [label="Command:\nQualifyLead\nCreateOpportunity", style=solid, color="#111827"];
  Opportunity -> SalesActivity [label="Command:\nRegisterActivity", style=solid, color="#111827"];
  Opportunity -> FollowUpTask [label="Command:\nPlanNextStep", style=solid, color="#111827"];
  OrderProcess -> BackofficeTask [label="Command:\nCreate/AssignTask", style=solid, color="#111827"];
  OrderProcess -> FulfillmentRequest [label="Command:\nAcceptForFulfillment", style=solid, color="#111827"];
  Salesperson -> Clarification [label="Command:\nProvideMissingInfo", style=solid, color="#111827"];

  // Cross-context events
  Customer -> Lead [label="Event:\nCustomerCreated\n/kiedy: nowy klient", style=dashed, color="#ea580c", fontcolor="#9a3412", ltail=cluster_customers, lhead=cluster_sales];
  Opportunity -> SalesOrder [label="Event:\nOpportunityWon\n/kiedy: wygrana sprzedaż", style=dashed, color="#ea580c", fontcolor="#9a3412", ltail=cluster_sales, lhead=cluster_orders];
  SalesOrder -> OrderProcess [label="Event:\nSalesOrderSubmitted\n/kiedy: zamówienie kompletne\ni przekazane", style=dashed, color="#ea580c", fontcolor="#9a3412", ltail=cluster_orders, lhead=cluster_backoffice];
  Clarification -> FollowUpTask [label="Event:\nMissingInformationRequested\n/kiedy: braki w danych", style=dashed, color="#ea580c", fontcolor="#9a3412", ltail=cluster_backoffice, lhead=cluster_sales];
  OrderProcess -> IntegrationJob [label="Event:\nOrderAcceptedForFulfillment\nInvoiceRequested", style=dashed, color="#ea580c", fontcolor="#9a3412", ltail=cluster_backoffice, lhead=cluster_integrations];
  IntegrationJob -> ERP [label="API call:\nExportOrder / CreateInvoice", style=solid, color="#111827"];
  ERP -> IntegrationJob [label="Webhook/Event:\nInvoiceIssued\nPaymentReceived", style=dashed, color="#ea580c", fontcolor="#9a3412"];
  OrderProcess -> SalesActivity [label="Event:\nOrderCompleted\n/kiedy: realizacja zakończona\n→ kontakt posprzedażowy", style=dashed, color="#ea580c", fontcolor="#9a3412", ltail=cluster_backoffice, lhead=cluster_sales];

  // Reporting projections
  Customer -> SalesKPI [label="Event → projection", style=dotted, color="#6b7280", fontcolor="#4b5563", ltail=cluster_customers, lhead=cluster_reporting];
  Opportunity -> PipelineReport [label="Events:\nStageChanged/Won/Lost", style=dotted, color="#6b7280", fontcolor="#4b5563", ltail=cluster_sales, lhead=cluster_reporting];
  SalesOrder -> OrderReport [label="Event:\nSalesOrderSubmitted", style=dotted, color="#6b7280", fontcolor="#4b5563", ltail=cluster_orders, lhead=cluster_reporting];
  OrderProcess -> OrderReport [label="Events:\nStarted/Completed/Rejected", style=dotted, color="#6b7280", fontcolor="#4b5563", ltail=cluster_backoffice, lhead=cluster_reporting];
  IntegrationJob -> OrderReport [label="Events:\nInvoiceIssued/PaymentReceived", style=dotted, color="#6b7280", fontcolor="#4b5563", ltail=cluster_integrations, lhead=cluster_reporting];
}
