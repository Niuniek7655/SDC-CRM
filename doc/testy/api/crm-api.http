# SDC-CRM API - żądania do klienta HTTP w Riderze (JetBrains HTTP Client).
#
# 1. Wybierz środowisko "local" (http-client.env.json: baseUrl).
# 2. Tokeny zapisz w http-client.private.env.json obok tego pliku (plik jest ignorowany przez git):
#      { "local": { "salespersonToken": "...", "otherSalesToken": "...", "backofficeToken": "..." } }
#    Token: zaloguj się w aplikacji web danym użytkownikiem i w konsoli DevTools wykonaj
#      copy(sessionStorage.getItem('access_token'))
# 3. Uruchamiaj pojedyncze żądania albo cały plik ("Run All Requests in File") - testy w blokach > {% %}.
#
# Opis scenariuszy: doc/testy/04-testy-endpointow-api.md

### API-01 Moje leady bez tokena -> 401
GET {{baseUrl}}/api/leads/mine
X-Correlation-ID: http-client-api-01

> {%
    client.global.set("ownerAIds", []);
    client.global.set("ownerBIds", []);
    client.test("API-01: 401 bez tokena", function () {
        client.assert(response.status === 401, "Oczekiwano 401, otrzymano " + response.status);
    });
    client.test("API-04: X-Correlation-ID wraca w odpowiedzi", function () {
        client.assert(response.headers.valueOf("X-Correlation-ID") === "http-client-api-01", "Nagłówek: " + response.headers.valueOf("X-Correlation-ID"));
    });
%}

### API-02 Rejestracja leada bez tokena -> 401
POST {{baseUrl}}/api/leads
Content-Type: application/json

{
  "companyName": "[SMOKE] Bez tokena",
  "contactName": "Jan Kowalski",
  "contactEmail": "jan.kowalski@acme.test"
}

> {%
    client.test("API-02: 401 bez tokena", function () {
        client.assert(response.status === 401, "Oczekiwano 401, otrzymano " + response.status);
    });
%}

### API-08 Dokument OpenAPI (tylko środowisko Development)
GET {{baseUrl}}/openapi/v1.json

> {%
    client.test("API-08: dokument OpenAPI opisuje /api/leads", function () {
        client.assert(response.status === 200, "Oczekiwano 200, otrzymano " + response.status);
        client.assert(response.body.paths["/api/leads"] !== undefined, "Brak ścieżki /api/leads");
        client.assert(response.body.paths["/api/leads/mine"] !== undefined, "Brak ścieżki /api/leads/mine");
    });
%}

### API-10 Moje leady (handlowiec) -> 200
GET {{baseUrl}}/api/leads/mine
Authorization: Bearer {{salespersonToken}}

> {%
    client.test("API-10: 200 i tablica", function () {
        client.assert(response.status === 200, "Oczekiwano 200, otrzymano " + response.status);
        client.assert(Array.isArray(response.body), "Oczekiwano tablicy JSON");
    });
%}

### API-11 Rejestracja leada ze wszystkimi polami -> 201
POST {{baseUrl}}/api/leads
Authorization: Bearer {{salespersonToken}}
Content-Type: application/json
X-Correlation-ID: http-client-api-11

{
  "companyName": "[SMOKE] Acme Sp. z o.o.",
  "contactName": "Jan Kowalski",
  "contactEmail": "jan.kowalski@acme.test",
  "contactPhone": "+48 600 100 200",
  "source": "Targi"
}

> {%
    client.test("API-11: 201 z id i Location", function () {
        client.assert(response.status === 201, "Oczekiwano 201, otrzymano " + response.status);
        client.assert(response.body.id, "Brak id w odpowiedzi");
        client.assert(response.headers.valueOf("Location"), "Brak nagłówka Location");
    });
    client.global.set("leadId", response.body.id);
    if (response.status === 201 && response.body.id) { var ids = client.global.get("ownerAIds") || []; ids.push(response.body.id); client.global.set("ownerAIds", ids); }
%}

### API-12 Rejestracja leada tylko z polami wymaganymi -> 201
POST {{baseUrl}}/api/leads
Authorization: Bearer {{salespersonToken}}
Content-Type: application/json

{
  "companyName": "[SMOKE] Minimal",
  "contactName": "Anna Nowak",
  "contactEmail": "anna@beta.test"
}

> {%
    client.test("API-12: 201", function () {
        client.assert(response.status === 201, "Oczekiwano 201, otrzymano " + response.status);
    });
    client.global.set("leadId", response.body.id);
    if (response.status === 201 && response.body.id) { var ids = client.global.get("ownerAIds") || []; ids.push(response.body.id); client.global.set("ownerAIds", ids); }
%}

### API-13 Nowy lead na liście, status New, najnowszy pierwszy
GET {{baseUrl}}/api/leads/mine
Authorization: Bearer {{salespersonToken}}

> {%
    client.test("API-13: ostatnio utworzony lead jest pierwszy i ma status New", function () {
        var expectedId = client.global.get("leadId");
        client.assert(response.status === 200, "Oczekiwano 200, otrzymano " + response.status);
        client.assert(response.body.length > 0, "Lista jest pusta");
        client.assert(response.body[0].id === expectedId, "Pierwszy na liście: " + response.body[0].id + ", oczekiwano " + expectedId);
        client.assert(response.body[0].status === "New", "Status: " + response.body[0].status);
    });
%}

### API-14 Nazwa firmy z samych spacji -> 400 (reguła domenowa)
POST {{baseUrl}}/api/leads
Authorization: Bearer {{salespersonToken}}
Content-Type: application/json

{
  "companyName": "   ",
  "contactName": "Jan Kowalski",
  "contactEmail": "jan.kowalski@acme.test"
}

> {%
    client.test("API-14: 400 z regułą domenową", function () {
        client.assert(response.status === 400, "Oczekiwano 400, otrzymano " + response.status);
        client.assert(response.body.detail === "A lead must have a company name.", "detail: " + response.body.detail);
    });
%}

