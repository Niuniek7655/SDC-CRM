### API-16 E-mail bez @ -> 400 (value object Email)
POST {{baseUrl}}/api/leads
Authorization: Bearer {{salespersonToken}}
Content-Type: application/json

{
  "companyName": "[SMOKE] Gamma",
  "contactName": "Jan Kowalski",
  "contactEmail": "jan.kowalski"
}

> {%
    client.test("API-16: 400 dla niepoprawnego e-maila", function () {
        client.assert(response.status === 400, "Oczekiwano 400, otrzymano " + response.status);
        client.assert(response.body.detail.indexOf("is not valid") >= 0, "detail: " + response.body.detail);
    });
%}

