### API-20 assignedSalespersonId w treści jest ignorowany (właściciel z tokena)
POST {{baseUrl}}/api/leads
Authorization: Bearer {{salespersonToken}}
Content-Type: application/json

{
  "companyName": "[SMOKE] Owner",
  "contactName": "Jan Kowalski",
  "contactEmail": "jan.kowalski@acme.test",
  "assignedSalespersonId": "{{$uuid}}"
}

> {%
    client.test("API-20: 201", function () {
        client.assert(response.status === 201, "Oczekiwano 201, otrzymano " + response.status);
    });
    client.global.set("leadId", response.body.id);
%}

### API-20 (kontrola) Lead trafił na listę wywołującego
GET {{baseUrl}}/api/leads/mine
Authorization: Bearer {{salespersonToken}}

> {%
    client.test("API-20: lead na liście właściciela z tokena", function () {
        var expectedId = client.global.get("leadId");
        var found = response.body.some(function (lead) { return lead.id === expectedId; });
        client.assert(found, "Lead " + expectedId + " nie występuje na liście wywołującego");
    });
%}

### API-30 Inny użytkownik sprzedaży nie widzi leada handlowca
GET {{baseUrl}}/api/leads/mine
Authorization: Bearer {{otherSalesToken}}

> {%
    client.test("API-30: brak cudzego leada", function () {
        var foreignId = client.global.get("leadId");
        client.assert(response.status === 200, "Oczekiwano 200, otrzymano " + response.status);
        var found = response.body.some(function (lead) { return lead.id === foreignId; });
        client.assert(!found, "Widoczny cudzy lead " + foreignId);
    });
%}

