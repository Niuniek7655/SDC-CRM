### API-20 assignedSalespersonId w treści jest ignorowany (właściciel z tokena)
POST {{baseUrl}}/api/leads
Authorization: Bearer {{salespersonToken}}
Content-Type: application/json

{
  "companyName": "[SMOKE] Owner",
  "contactName": "Jan Kowalski",
  "contactEmail": "jan.kowalski@acme.test",
  "assignedSalespersonId": "{{$uuid}}"
}

> {%
    client.test("API-20: 201", function () {
        client.assert(response.status === 201, "Oczekiwano 201, otrzymano " + response.status);
    });
    client.global.set("leadId", response.body.id);
    if (response.status === 201 && response.body.id) { var ids = client.global.get("ownerAIds") || []; ids.push(response.body.id); client.global.set("ownerAIds", ids); }
%}

### API-20 (kontrola) Lead trafił na listę wywołującego
GET {{baseUrl}}/api/leads/mine
Authorization: Bearer {{salespersonToken}}

> {%
    client.test("API-20: lead na liście właściciela z tokena", function () {
        var expectedId = client.global.get("leadId");
        var found = response.body.some(function (lead) { return lead.id === expectedId; });
        client.assert(found, "Lead " + expectedId + " nie występuje na liście wywołującego");
    });
%}


### API-31 Użytkownik B tworzy pierwszy własny rekord
POST {{baseUrl}}/api/leads
Authorization: Bearer {{otherSalesToken}}
Content-Type: application/json

{"companyName":"[SMOKE] B1","contactName":"Anna","contactEmail":"anna@example.test"}

> {%
    client.test("API-31: B tworzy własny rekord", function () {
        client.assert(response.status === 201 && response.body.id, "Brak 201/id B1");
    });
    if (response.status === 201 && response.body.id) client.global.set("ownerBIds", [response.body.id]);
%}

### API-32 Użytkownik B tworzy drugi własny rekord
POST {{baseUrl}}/api/leads
Authorization: Bearer {{otherSalesToken}}
Content-Type: application/json

{"companyName":"[SMOKE] B2","contactName":"Anna","contactEmail":"anna@example.test"}

> {%
    client.test("API-32: B tworzy drugi własny rekord", function () {
        client.assert(response.status === 201 && response.body.id, "Brak 201/id B2");
    });
    if (response.status === 201 && response.body.id) { var ids = client.global.get("ownerBIds") || []; ids.push(response.body.id); client.global.set("ownerBIds", ids); }
%}

### API-30 B widzi oba własne rekordy i nie widzi żadnego rekordu A
GET {{baseUrl}}/api/leads/mine
Authorization: Bearer {{otherSalesToken}}

> {%
    client.test("API-30: izolacja B", function () {
        var own = client.global.get("ownerBIds") || [];
        var foreign = client.global.get("ownerAIds") || [];
        client.assert(own.length === 2 && foreign.length === 3, "Uruchom cały plik od API-01: wymagane trzy rekordy A i dwa B");
        client.assert(response.status === 200 && Array.isArray(response.body), "Brak 200/tablicy B");
        own.forEach(function(id) { client.assert(response.body.some(function(x) { return x.id === id; }), "B nie widzi własnego " + id); });
        foreign.forEach(function(id) { client.assert(!response.body.some(function(x) { return x.id === id; }), "B widzi cudzy " + id); });
    });
%}

### API-33 A widzi swoje rekordy i nie widzi żadnego B
GET {{baseUrl}}/api/leads/mine
Authorization: Bearer {{salespersonToken}}

> {%
    client.test("API-33: izolacja A", function () {
        var own = client.global.get("ownerAIds") || [];
        var foreign = client.global.get("ownerBIds") || [];
        client.assert(own.length === 3 && foreign.length === 2, "Wymagane dane obu użytkowników");
        client.assert(response.status === 200 && Array.isArray(response.body), "Brak 200/tablicy A");
        own.forEach(function(id) { client.assert(response.body.some(function(x) { return x.id === id; }), "A nie widzi własnego " + id); });
        foreign.forEach(function(id) { client.assert(!response.body.some(function(x) { return x.id === id; }), "A widzi cudzy " + id); });
    });
%}

