> {% client.test("API-05: bezpieczny nowy identyfikator", function () { client.assert(response.status === 401, "Oczekiwano 401"); client.assert(/^[a-f0-9]{32}$/.test(response.headers.valueOf("X-Correlation-ID")), "Brak nowego trace-id"); }); %}

