flowchart LR
  subgraph CM[Customer Management]
    Customer[Aggregate: Customer]
  end

  subgraph LP[Lead & Pipeline]
    Lead[Aggregate: Lead]
    Opportunity[Aggregate: Opportunity]
    Pipeline[Aggregate: Pipeline]
    Lead -->|CreateOpportunity| Opportunity
    Opportunity -->|check transition| Pipeline
  end

  subgraph SA[Sales Activity]
    SalesActivity[Aggregate: SalesActivity]
    FollowUpTask[Aggregate: FollowUpTask]
    Note[Aggregate: Note]
  end

  subgraph SO[Sales Order Capture]
    SalesOrder[Aggregate: SalesOrder]
  end

  subgraph BO[Backoffice Order Processing]
    OrderProcess[Aggregate: OrderProcess]
    BackofficeTask[Aggregate: BackofficeTask]
    OrderProcess -->|create operational task| BackofficeTask
  end

  subgraph IC[Integration Context]
    IntegrationJob[Aggregate: IntegrationJob]
    ExternalSystemMapping[Aggregate: ExternalSystemMapping]
    InvoiceRequest[Aggregate: InvoiceRequest]
  end

  subgraph RA[Reporting & Analytics]
    SalesPipelineReport[Read model: SalesPipelineReport]
    SalespersonKpiReport[Read model: SalespersonKpiReport]
    OrderProcessingReport[Read model: OrderProcessingReport]
    RevenueReport[Read model: RevenueReport]
  end

  Customer -. CustomerCreated / CustomerUpdated .-> Lead
  Customer -. CustomerCreated / CustomerUpdated .-> RA
  SalesOrder -->|sync query: customer snapshot| Customer
  Opportunity -. OpportunityWon .-> SalesOrder
  SalesOrder -. SalesOrderSubmitted .-> OrderProcess
  OrderProcess -. MissingInformationRequested .-> FollowUpTask
  OrderProcess -. OrderAcceptedForFulfillment / InvoiceRequested .-> IntegrationJob
  OrderProcess -. OrderAcceptedForFulfillment / InvoiceRequested .-> InvoiceRequest
  IntegrationJob -. InvoiceIssued / PaymentReceived .-> RA
  OrderProcess -. OrderCompleted .-> RA
  Opportunity -. OpportunityWon / OpportunityLost .-> RA
  SalesOrder -. SalesOrderCreated / SalesOrderSubmitted .-> RA
